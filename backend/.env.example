# =============================================================================
# Career Platform MVP backend — environment template
# Copy to .env and adjust. Every variable is validated by app/core/config.py
# (pydantic-settings); a malformed value fails fast at startup.
# =============================================================================

# --- Application ---
# development | test | production
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Career Platform MVP API"
API_V1_PREFIX=/api/v1
# Serve /docs and /redoc even when ENVIRONMENT=production (keep off by default)
DOCS_IN_PRODUCTION=false

# --- PostgreSQL (docker compose maps host 5435 -> container 5432) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_USER=career_user
POSTGRES_PASSWORD=career_password
POSTGRES_DB=career_platform_mvp
# Full-DSN override for managed Postgres (Railway & co. hand out one URL):
# postgres://user:password@host:port/db — query params like ?sslmode=require
# are preserved. Takes precedence over the discrete parts above. Empty =
# local dev (discrete parts).
DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- CORS (comma-separated list of allowed browser origins; no '*') ---
# Include both hostname spellings: browsers treat http://127.0.0.1:3000 and
# http://localhost:3000 as different origins, and Vite/preview links use either.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
